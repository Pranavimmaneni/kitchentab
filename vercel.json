{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs"
    },
    "api": {
      "root": "apps/api/",
      "framework": "fastapi",
      "entrypoint": "app.vercel_entry:app"
    }
  },
  "rewrites": [
    { "source": "/api/blob-upload", "destination": { "service": "web" } },
    { "source": "/api/blob-view", "destination": { "service": "web" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/api/v1/cron/daily", "schedule": "0 11 * * *" }]
}
