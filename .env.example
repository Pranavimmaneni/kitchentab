# Copy to .env and fill in. Never commit .env.
# Local dev works with the defaults below (fakes for SMS, email and the extractor).

# --- App ---
APP_ENV=local                      # local | staging | prod
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
PUBLIC_LINK_BASE=http://localhost:3000   # used to build /b/ and /h/ links
SESSION_SECRET=change-me-64-random-bytes
TOKEN_HASH_PEPPER=change-me-32-random-bytes

# --- Database / cache ---
DATABASE_URL=postgresql+asyncpg://kitchentab:kitchentab@localhost:5432/kitchentab
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, S3 or R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kitchentab-receipts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# --- Auth: Google OIDC ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Email (Mailpit locally) ---
EMAIL_PROVIDER=fake                # fake | resend | postmark | ses
EMAIL_FROM="KitchenTab <hello@example.com>"
RESEND_API_KEY=
SMTP_URL=smtp://localhost:1025     # Mailpit

# --- SMS codes ---
SMS_PROVIDER=fake                  # fake | twilio_verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Bot protection ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Receipt extraction ---
EXTRACTOR_PROVIDER=fake            # fake | <vision LLM provider>
EXTRACTOR_API_KEY=
EXTRACTOR_MODEL=
EXTRACTOR_DAILY_CAP_PER_HOUSE=30

# --- Web Push (generate keys: npx web-push generate-vapid-keys) ---
PUSH_PROVIDER=fake                 # fake | webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
FAKE_PUSH_URL=http://localhost:4010   # test/dev only

# --- Test-only switches (never set in prod) ---
TEST_ROUTES_ENABLED=false          # enables /__test/* (clock, sms, push inbox) when APP_ENV=test

# --- Observability ---
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=
