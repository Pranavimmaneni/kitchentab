# Copy to .env and fill in. Never commit .env.
# Local dev works with these defaults (fakes for SMS, email, push and extraction).

# --- App ---
APP_ENV=local                      # local | test | staging | prod
PROFILE=local                      # local (Redis, arq, MinIO) | vercel (production adapters; ADR-0017)
WEB_ORIGIN=http://localhost:3000
PUBLIC_LINK_BASE=http://localhost:3000   # used to build /b/ and /h/ links
SESSION_SECRET=change-me-64-random-bytes
TOKEN_HASH_PEPPER=change-me-32-random-bytes
CRON_SECRET=change-me-32-random-bytes    # Vercel cron calls send it as a bearer token

# --- Database / cache ---
DATABASE_URL=postgresql+asyncpg://kitchentab:kitchentab@localhost:5432/kitchentab
DB_SERVERLESS_POOL_SIZE=                 # PROFILE=vercel: connections kept per API instance (default 10; 0 = none, ADR-0032)
DATABASE_DIRECT_URL=               # Neon direct URL for migrations (prod); empty = DATABASE_URL
REDIS_URL=redis://localhost:6379/0 # PROFILE=local only

# --- Receipt storage (ADR-0015) ---
STORAGE_PROVIDER=s3                # s3 (MinIO) | fakeblob | vercel_blob
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kitchentab-receipts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
FAKE_BLOB_URL=http://localhost:4012     # fake Vercel Blob service (docker compose `fake-blob`)
BLOB_READ_WRITE_TOKEN=             # set by the Vercel Blob store in prod; empty with fakeblob = the fake's built-in token

# --- Queue (ADR-0013) ---
QUEUE_PROVIDER=                    # empty = arq with PROFILE=local, vercel with PROFILE=vercel
VERCEL_QUEUE_BASE_URL=             # local queue devserver URL for PROFILE=vercel

# --- Email (ADR-0016) ---
EMAIL_PROVIDER=fake                # fake (Mailpit) | smtp (Gmail) | testinbox
EMAIL_FROM="KitchenTab <hello@example.com>"
EMAIL_POSTAL_ADDRESS=                # footer of notification emails (CAN-SPAM); set before launch
SMTP_URL=smtp://localhost:1025     # Mailpit, used by EMAIL_PROVIDER=fake
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                     # Gmail app password, set by `make set-email`
TEST_INBOX_SECRET=                 # 64+ random chars when EMAIL_PROVIDER=testinbox

# --- Optional sign-in methods (buttons hidden until set) ---
GOOGLE_ISSUER=http://localhost:4011      # mock OIDC locally; https://accounts.google.com in prod
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
SMS_PROVIDER=fake                  # none | fake | twilio_verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Receipt extraction (ADR-0010) ---
EXTRACTOR_PROVIDER=local           # local (no key) | fake (tests) | llm (optional plugin)
EXTRACTOR_API_KEY=
EXTRACTOR_MODEL=
EXTRACTOR_DAILY_CAP_PER_HOUSE=30

# --- Web Push (generate keys: npx web-push generate-vapid-keys) ---
PUSH_PROVIDER=fake                 # fake | webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
FAKE_PUSH_URL=http://localhost:4010

# --- Test-only switches (never set in prod) ---
TEST_ROUTES_ENABLED=false          # enables /__test/* only when APP_ENV=test

# --- Observability ---
SENTRY_DSN=
